{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "maqayis/line",
  "title": "OcrLine",
  "description": "A merged visual line from Apple Vision observations",
  "type": "object",
  "required": [
    "line_id", "source_pdf", "pdf_page",
    "bounding_box",
    "raw_candidates", "corrected_candidates",
    "raw_ocr", "corrected_ocr",
    "region_type", "review_status"
  ],
  "properties": {
    "line_id":       { "type": "string", "description": "Unique id: '{pdf}:p{page}:l{n}'" },
    "source_pdf":    { "type": "string" },
    "pdf_page":      { "type": "integer", "minimum": 1 },
    "bounding_box": {
      "type": "object",
      "description": "Normalised coordinates [0,1] from Apple Vision (origin bottom-left)",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" }
      },
      "additionalProperties": false
    },
    "raw_candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["text", "confidence"],
        "properties": {
          "text":       { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "corrected_candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["text", "confidence"],
        "properties": {
          "text":       { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "raw_ocr":       { "type": "string", "description": "Top raw candidate (immutable)" },
    "corrected_ocr": { "type": "string", "description": "Top corrected candidate (immutable)" },
    "region_type": {
      "type": "string",
      "enum": [
        "BOOK_HEADING",
        "CHAPTER_HEADING",
        "ROOT_ENTRY_START",
        "MAIN_TEXT",
        "POETRY",
        "FOOTNOTE",
        "PAGE_HEADER",
        "PAGE_NUMBER",
        "UNKNOWN"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": ["AUTO_AGREED", "REVIEW_REQUIRED", "MANUALLY_CORRECTED", "APPROVED", "REJECTED"],
      "default": "AUTO_AGREED"
    },
    "human_text":    { "type": ["string", "null"], "default": null },
    "reviewer":      { "type": ["string", "null"], "default": null },
    "review_date":   { "type": ["string", "null"], "format": "date", "default": null },
    "notes":         { "type": ["string", "null"], "default": null },
    "observation_ids": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "Indices of Apple Vision observations merged into this line"
    }
  },
  "additionalProperties": false
}
